class_name LevelBackground
extends Node2D
## Parallax data-center background. Layers further away scroll slower, both sideways and up and
## down, which gives the level depth and keeps the background calm when the player jumps. Each layer
## is one storey of the hall (see TILE_H) that repeats vertically as well as sideways, with its server
## racks standing on a floor drawn inside the image, so they never float and the picture never ends. Art is generated by tools/art/generate_background.py (which also
## blurs the layers for depth of field).
##
## The tints dim and cool each layer so the background recedes and the gameplay plane
## in front (tiles, machines, player) stands out. Raise them for a brighter backdrop.

# DIR: folder holding the generated layer images (far, mid_base, mid_leds_a, mid_leds_b,
# cables). Change it to use a different theme's set of images.
const DIR := "res://assets/backgrounds/data_center/"

# TILE_W: width in pixels of each layer image. It is used as the parallax repeat size, so the
# image repeats seamlessly sideways. It must equal the image width produced by
# tools/art/generate_background.py, or you get gaps or overlaps at the seams.
const TILE_W := 1280

# TILE_H: height in pixels of each layer image, one storey of the hall. Layers repeat vertically with this
# period. It must equal the image height produced by tools/art/generate_background.py.
const TILE_H := 700

# TINTS: colours multiplied over each layer image (Sprite2D.modulate). White leaves the image
# unchanged, lower values darken it, and uneven channels shift the colour (a blue bias makes
# it cooler). Dimmer and cooler layers look further away, which keeps the background from
# competing with the gameplay in front of it.

# FAR_TINT: the farthest layer (the distant hall). Raise it to make the background brighter
# and more prominent, lower it to push it back.
const FAR_TINT := Color(0.50, 0.56, 0.74)

# MID_TINT: the racks layer.
const MID_TINT := Color(0.40, 0.45, 0.62)

# MID_LEDS_TINT: the blinking LEDs on the racks. Kept slightly brighter than MID_TINT so
# they still read as lights.
const MID_LEDS_TINT := Color(0.52, 0.58, 0.78)

# CABLES_TINT: the ceiling cables and support columns layer.
const CABLES_TINT := Color(0.46, 0.50, 0.64)


func _ready() -> void:
	_layer("far", 0.12, -30, FAR_TINT)
	_layer("mid_base", 0.40, -28, MID_TINT)
	# Two LED layers pulse in opposite phase so the racks look alive.
	_pulse(_layer("mid_leds_a", 0.40, -27, MID_LEDS_TINT), 0.0)
	_pulse(_layer("mid_leds_b", 0.40, -27, MID_LEDS_TINT), 0.9)
	_layer("cables", 0.70, -26, CABLES_TINT)


func _layer(image: String, scroll: float, z: int, tint: Color) -> Sprite2D:
	var p := Parallax2D.new()
	p.scroll_scale = Vector2(scroll, scroll)
	p.repeat_size = Vector2(TILE_W, TILE_H)
	p.repeat_times = 4
	p.z_index = z
	add_child(p)

	var s := Sprite2D.new()
	s.texture = load(DIR + image + ".png")
	s.centered = false
	s.modulate = tint
	p.add_child(s)
	return s


func _pulse(s: Sprite2D, delay: float) -> void:
	var tw := create_tween().set_loops()
	tw.tween_interval(delay)
	tw.tween_property(s, "modulate:a", 0.25, 0.9).set_trans(Tween.TRANS_SINE)
	tw.tween_property(s, "modulate:a", 1.0, 0.9).set_trans(Tween.TRANS_SINE)
	tw.tween_interval(0.9 - delay)
