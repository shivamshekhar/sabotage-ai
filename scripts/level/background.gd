class_name LevelBackground
extends Node2D
## Parallax data-center background. Layers further away scroll slower, which gives
## the level depth. Art is generated by tools/art/generate_background.py (which also
## blurs the layers for depth of field).
##
## The tints dim and cool each layer so the background recedes and the gameplay plane
## in front (tiles, machines, player) stands out. Raise them for a brighter backdrop.

const DIR := "res://assets/backgrounds/data_center/"
const TILE_W := 1280  # width of each (seamlessly tiling) layer image

const FAR_TINT := Color(0.50, 0.56, 0.74)
const MID_TINT := Color(0.40, 0.45, 0.62)
const MID_LEDS_TINT := Color(0.52, 0.58, 0.78)   # LEDs stay a touch brighter than the racks
const CABLES_TINT := Color(0.46, 0.50, 0.64)


func _ready() -> void:
	_layer("far", 0.12, -30, FAR_TINT)
	_layer("mid_base", 0.40, -28, MID_TINT)
	# Two LED layers pulse in opposite phase so the racks look alive.
	_pulse(_layer("mid_leds_a", 0.40, -27, MID_LEDS_TINT), 0.0)
	_pulse(_layer("mid_leds_b", 0.40, -27, MID_LEDS_TINT), 0.9)
	_layer("cables", 0.70, -26, CABLES_TINT)


func _layer(image: String, scroll: float, z: int, tint: Color) -> Sprite2D:
	var p := Parallax2D.new()
	p.scroll_scale = Vector2(scroll, scroll)
	p.repeat_size = Vector2(TILE_W, 0)
	p.repeat_times = 4
	p.z_index = z
	add_child(p)

	var s := Sprite2D.new()
	s.texture = load(DIR + image + ".png")
	s.centered = false
	s.modulate = tint
	p.add_child(s)
	return s


func _pulse(s: Sprite2D, delay: float) -> void:
	var tw := create_tween().set_loops()
	tw.tween_interval(delay)
	tw.tween_property(s, "modulate:a", 0.25, 0.9).set_trans(Tween.TRANS_SINE)
	tw.tween_property(s, "modulate:a", 1.0, 0.9).set_trans(Tween.TRANS_SINE)
	tw.tween_interval(0.9 - delay)
