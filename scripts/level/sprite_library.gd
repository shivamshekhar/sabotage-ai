class_name SpriteLibrary
extends RefCounted
## Central place that knows where art lives on disk. Everything else asks for sprites by name,
## so moving or swapping art only touches this file.
##
## Art is nested as   assets/<component>/<style>/<group>/<file>.png   and file names never
## change, so a sprite's name is enough to find it:
##   tiles       <style>/<category>/<sprite>.png        category comes from the name's first word
##   characters  <style>/<character>/<character>_<pose>.png
##   machines    <style>/<machine>/<sprite>.png         machine comes from the sprite name

# TILE_DIR: folder of the original Kenney level sprites (the "base" tile style). tile() falls
# back to it when no themed version of a sprite exists. Sprites are inside category folders
# (see TILE_CATEGORIES). Move the art and you only need to change this.
const TILE_DIR := "res://assets/tiles/kenney_industrial/"

# THEMED_TILE_DIR: folder of the data-center themed replacements (generated by
# tools/art/generate_tiles.py), laid out like TILE_DIR. tile() prefers a sprite with the same name
# from here, so you can restyle any tile by dropping a file with the same name in the matching
# category folder.
const THEMED_TILE_DIR := "res://assets/tiles/data_center/"

# TILE_CATEGORIES: which category folder a tile lives in, keyed by the first word of its name
# (the part before the first underscore): "ground_start" -> "ground" -> terrain/. Both tile
# folders use this, and tools/art/generate_tiles.py uses the same grouping when it writes files.
# To add a new kind of tile, add its first word here, then put the file in that category folder.
# tools/tests/assets_test.gd checks that every file is in the folder this table says.
const TILE_CATEGORIES := {
	"ground": "terrain", "ledge": "terrain", "slime": "terrain",
	"block": "structure", "ladder": "structure", "scaffold": "structure",
	"pipe": "structure", "rail": "structure", "glass": "structure",
	"monitor": "equipment", "panel": "equipment", "gear": "equipment", "canister": "equipment",
	"spikes": "hazards", "hazard": "hazards", "barrier": "hazards",
	"siren": "lights", "lamp": "lights",
	"arrow": "signage", "sign": "signage",
}

# CHARACTER_DIR: folder of the character poses (one style here), with one subfolder per
# character. character_pose() builds <CHARACTER_DIR>/<character>/<character>_<pose>.png.
const CHARACTER_DIR := "res://assets/characters/kenney_platformer/"

# MACHINE_DIR: folder of the generated machine sprites. Each machine has its own subfolder
# holding its image plus its LED and shadow images; see machine_folder() for the naming rule.
const MACHINE_DIR := "res://assets/machines/data_center/"

# MACHINE_FILE_SUFFIXES: endings that mark a machine's extra images (LED layers and shadow). They
# are removed from a sprite's name to find which machine the file belongs to, so
# "machine_gpu_rack_leds_a" is stored with "machine_gpu_rack".
const MACHINE_FILE_SUFFIXES := ["_leds_a", "_leds_b", "_shadow"]

# MACHINE_PARTS: sprites that are not a machine themselves but a moving part shared by several
# (for example the fan blades). They live together in MACHINE_PARTS_FOLDER instead of getting
# a folder each.
const MACHINE_PARTS := ["machine_fan"]

# MACHINE_PARTS_FOLDER: name of the folder, inside MACHINE_DIR, that holds MACHINE_PARTS.
const MACHINE_PARTS_FOLDER := "parts"

# PIT_DIR: folder of the deadly-pit art, one subfolder per kind. pit() builds
# <PIT_DIR>/<kind>/pit_<kind>_<part>.png.
const PIT_DIR := "res://assets/pit_hazards/"

# PIT_KINDS: every kind of deadly pit liquid (see PitHazard) and the map character that draws it. Each has a "liquid"
# tile; the piranha tank also has the parts of its robot fish: "fish_body", "fish_jaw" and "fish_eye". The generator
# (tools/art/generate_pit_hazards.py) writes these files.
const PIT_KINDS := {
	"toxic_waste": "A", "lava": "F", "nuclear_waste": "N", "piranha_tank": "W",
}
const PIT_PARTS := ["liquid"]
const PIT_FISH_PARTS := ["fish_body", "fish_jaw", "fish_eye"]

# PROJECTILE_DIR: folder of the throwable pixel-art objects, one subfolder per group.
# projectile() builds <PROJECTILE_DIR>/<group>/projectile_<name>.png.
const PROJECTILE_DIR := "res://assets/projectiles/pixel_art/"

# PROJECTILES: every throwable object and the group folder it lives in. The generator
# (tools/art/generate_projectiles.py) writes these files. To add one, draw it there, then list it here.
# The player picks a random one for each throw (see Projectile).
const PROJECTILES := {
	"mona_lisa": "paintings", "starry_night": "paintings", "great_wave": "paintings",
	"pearl_earring": "paintings", "the_scream": "paintings", "vitruvian_man": "paintings",
	"cat_photo": "cats",
	"paintbrush": "everyday", "pencil": "everyday", "book": "everyday",
	"vinyl_record": "everyday", "film_camera": "everyday",
}

static var _cache := {}


## A deadly-pit image: kind is a key of PIT_KINDS, part one of PIT_PARTS (or PIT_FISH_PARTS for the piranha tank).
static func pit(kind: String, part: String) -> Texture2D:
	return _load("%s%s/pit_%s_%s.png" % [PIT_DIR, kind, kind, part])


## A throwable object's sprite by name, e.g. "mona_lisa" (see PROJECTILES).
static func projectile(object_name: String) -> Texture2D:
	return _load("%s%s/projectile_%s.png" % [PROJECTILE_DIR, PROJECTILES[object_name], object_name])


## Machine sprite by name, e.g. "machine_gpu_rack" or "machine_gpu_rack_leds_a".
static func machine(sprite_name: String) -> Texture2D:
	return _load("%s%s/%s.png" % [MACHINE_DIR, machine_folder(sprite_name), sprite_name])


## Which folder (inside MACHINE_DIR) a machine sprite lives in: its machine's name without the
## "machine_" prefix, or MACHINE_PARTS_FOLDER for shared parts.
## "machine_gpu_rack_shadow" -> "gpu_rack"; "machine_fan" -> "parts".
static func machine_folder(sprite_name: String) -> String:
	var base := sprite_name
	for suffix in MACHINE_FILE_SUFFIXES:
		base = base.trim_suffix(suffix)
	if base in MACHINE_PARTS:
		return MACHINE_PARTS_FOLDER
	return base.trim_prefix("machine_")


## Level tile / prop sprite by name, e.g. "ground_start" (the numbered originals are mapped to
## these names in tiles/kenney_industrial/NAMES.md).
static func tile(sprite_name: String) -> Texture2D:
	var category := tile_category(sprite_name)
	var themed := "%s%s/%s.png" % [THEMED_TILE_DIR, category, sprite_name]
	if ResourceLoader.exists(themed):
		return _load(themed)
	return _load("%s%s/%s.png" % [TILE_DIR, category, sprite_name])


## Category folder of a tile name (see TILE_CATEGORIES). Empty, with an error, if the name's
## first word isn't in the table.
static func tile_category(sprite_name: String) -> String:
	var first_word := sprite_name.get_slice("_", 0)
	if not TILE_CATEGORIES.has(first_word):
		push_error("SpriteLibrary: no category for tile '%s'; add '%s' to TILE_CATEGORIES" % [sprite_name, first_word])
		return ""
	return TILE_CATEGORIES[first_word]


## Character pose, e.g. character_pose("player", "walk1").
static func character_pose(character: String, pose: String) -> Texture2D:
	return _load("%s%s/%s_%s.png" % [CHARACTER_DIR, character, character, pose])


static func _load(path: String) -> Texture2D:
	if not _cache.has(path):
		_cache[path] = load(path)
	return _cache[path]
