class_name SpriteLibrary
extends RefCounted
## Central place that knows where art lives on disk. Everything else asks for
## sprites by name, so moving or swapping art only touches this file.

const TILE_DIR := "res://assets/kenney/platformer-pack-industrial/sprites/"
## Data-center themed replacements (generated by tools/art/generate_tiles.py).
## Used when a sprite of the same name exists here; otherwise the Kenney original.
const THEMED_TILE_DIR := "res://assets/tiles/data_center/"
const CHARACTER_DIR := "res://assets/kenney/platformer-characters/"

## Multi-tile machines (GPU racks, supercomputers...) generated by tools/art/generate_machines.py.
const MACHINE_DIR := "res://assets/machines/data_center/"

static var _cache := {}


## Machine sprite by name, e.g. "machine_gpu_rack" or "machine_gpu_rack_leds_a".
static func machine(sprite_name: String) -> Texture2D:
	return _load(MACHINE_DIR + sprite_name + ".png")


## Level tile / prop sprite by name, e.g. "ground_start" (see sprites/NAMES.md).
static func tile(sprite_name: String) -> Texture2D:
	var themed := THEMED_TILE_DIR + sprite_name + ".png"
	if ResourceLoader.exists(themed):
		return _load(themed)
	return _load(TILE_DIR + sprite_name + ".png")


## Character pose, e.g. character_pose("player", "walk1").
static func character_pose(character: String, pose: String) -> Texture2D:
	return _load("%s%s/%s_%s.png" % [CHARACTER_DIR, character, character, pose])


static func _load(path: String) -> Texture2D:
	if not _cache.has(path):
		_cache[path] = load(path)
	return _cache[path]
