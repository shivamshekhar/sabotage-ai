{
	"_comment": "Rules for tools/audit_assets.py: what it needs to know about files that are loaded under a name the code builds at run time.",
	"looking_only_pattern": "(_sheet|preview|pose_[a-z]+)\\.png$",
	"always_used": ["scripts/core/main.gd"],
	"character_pose_pattern": "^assets/characters/[^/]+/(?P<skin>[a-z]+)/(?P=skin)_(?P<pose>[a-z0-9]+)\\.png$",
	"character_poses": ["idle", "walk1", "walk2", "jump", "fall", "climb1", "climb2", "hurt", "action1", "action2"]
}
